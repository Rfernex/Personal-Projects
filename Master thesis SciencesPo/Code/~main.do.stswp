
************ GENERAL INFORMATION *************
* Runtime : 20-30 min
* Specs : ???
**********************************************

use "/Users/rfernex/Documents/Education/SciencesPo/Courses/M2/Master thesis/Data/EEmploi_2002_2013/eec2010_2024.dta"

* rename variables 
rename trim trimester
rename noi individual
rename ident household 

* select variables
keep nafemp2n extrid mchpub fchpub annee achpub nbtot emp3nbh emp2nbh ///
uneprof schpubc schpubb schpuba autoentc autoentb sexe autoenta ///
nafemp3g010n nafemp2g010n chpubc chpubb plract nafg010n autoent ///
creaccp hhc empnbh tam1b extri ident statutr statut stat2 ///
stnred sousempl lnais tppred empnbh6 hhc6 cser acteu ddipl totnbh ///
stplc stche stc statuts4 statuts3 statuts2 soub soua sou raistp ///
nbtemp echpub dispplc cstplc creacc chpubs4 chpubs3 chpubs2 ///
chpub3 chpub2 chpub autsal am2nb am1nb age nafemp3n trimester ///
individual household inform nafemp2g004n nafg004n css2 css3 css4

* Create date variable 
gen date = yq(annee, trimester)
format date %tq

* sampling weights adjustment
svyset [pweight=extri]

* Create multi-emp / multi job categorical variable 
gen plur_cat = .
replace plur_cat = 0 if plract != 1
replace plur_cat = 99 if plract == 1
replace plur_cat = 1 if plract == 1 & uneprof == 2 & (nbtemp == 1 | nbtemp == .)
replace plur_cat = 2 if plract == 1 & uneprof == 1 & (nbtemp == 2 | nbtemp == 3)
replace plur_cat = 3 if plract == 1 & uneprof == 2 & (nbtemp == 2 | nbtemp == 3)
label define plur_lbl 0 "Not Pluriactive" 1 "Multi-Job/Single Emp" 2 "Single Job/Multi-Emp" 3 "Multi-Job/Multi-Emp" 99 "Undefined Pluriactive", replace
label values plur_cat plur_lbl


* Create Salaried/Non-Salaried (S/NS) categorical variable 
gen plur_type_INSEE = .
replace plur_type_INSEE = 0 if plract != 1
replace plur_type_INSEE = 99 if plract == 1
replace plur_type_INSEE = 1 if plract == 1 & uneprof == 1 & (nbtemp == 2 | nbtemp == 3)
replace plur_type_INSEE = 2 if plract == 1 & uneprof == 2 & stat2 == 2 & (inlist(statuts2, 1, 2, 4) | inlist(statuts3, 1, 2, 4) | inlist(statuts4, 1, 2, 4))
replace plur_type_INSEE = 4 if plract == 1 & uneprof == 2 & stat2 == 1 & (inlist(statuts2, 1, 2, 4) | inlist(statuts3, 1, 2, 4) | inlist(statuts4, 1, 2, 4))
replace plur_type_INSEE = 1 if plract == 1 & uneprof == 2 & stat2 == 2 & plur_type == 99 & (statuts2 != . | statuts3 != .| statuts4 != .) 
replace plur_type_INSEE = 3 if plract == 1 & uneprof == 2 & stat2 == 1 & plur_type == 99 & (statuts2 != . | statuts3 != .| statuts4 != .) 
label define pt_lbl 0 "Not Pluriactive" 1 "Salaried + Salaried" 2 "Salaried + Non-Salaried" 3 "Non-Salaried + Salaried" 4 "Non Salaried + Non Salaried" 99 "Undefined Pluriactive", replace
label values plur_type_INSEE pt_lb

* Create Self-Employed/Wage-Employed (IND/W) categorical variable 
gen plur_type = .
replace plur_type = 0 if plract != 1
replace plur_type = 99 if plract == 1
replace plur_type = 1 if plract == 1 & uneprof == 1 & (nbtemp == 2 | nbtemp == 3)
replace plur_type = 2 if plract == 1 & uneprof == 2 & stc == 3 & (inlist(statuts2, 1, 2) | inlist(statuts3, 1, 2) | inlist(statuts4, 1, 4))
replace plur_type = 4 if plract == 1 & uneprof == 2 & inlist(stc,1,2) & (inlist(statuts2, 1, 2) | inlist(statuts3, 1, 2) | inlist(statuts4, 1, 4))
replace plur_type = 1 if plract == 1 & uneprof == 2 & inlist(stc,1,2) & plur_type == 99 & ((statuts2 != . & statuts2 == 3) | (statuts3 != . & statuts3 == 4) | (statuts4 != . & statuts4 == 4)) 
replace plur_type = 3 if plract == 1 & uneprof == 2 & stc == 3 & plur_type == 99 & ((statuts2 != . & statuts2 == 3) | (statuts3 != . & statuts3 == 4) | (statuts4 != . & statuts4 == 4)) 
label define pt_lbl 0 "Not Pluriactive" 1 "Wage + Wage" 2 "Wage + Self" 3 "Self + Wage" 4 "Self + Self" 99 "Undefined Pluriactive", replace
label values plur_type pt_lbl

* Create Autoentrepreneur/Other (AUTO/OTH) categorical variable
capture drop plur_ae_type
gen byte plur_ae_type = 0
replace plur_ae_type = 99 if plract == 1
replace plur_ae_type = 2 if plract == 1 & autoent == 2 & (autoenta == 1 | autoentb == 1 | autoentc == 1)
replace plur_ae_type = 4 if plract == 1 & autoent == 1 & (autoenta == 1 | autoentb == 1 | autoentc == 1)
replace plur_ae_type = 1 if plract == 1 & autoent == 2 & plur_ae_type == 99 
replace plur_ae_type = 3 if plract == 1 & autoent == 1 & plur_ae_type == 99 
label define pae_lbl 0 "Non-Pluriactive" 1 "Other+Other" 2 "Other+Entrepreneur" 3 "Entrepreneur+Other" 4 "Entrepreneur+Entrepreneur" 99 "Undefined", replace
label values plur_ae_type pae_lbl

capture mkdir "output"

* EDA : Global Overview
run "proportions_plract.do"
run "proportions_plract_multi.do"
run "proportions_indep.do"

* EDA : Pluriactivity (on total active)
run "ABS_proportions_plract_S&NS.do"
run "ABS_proportions_plract_IND&W.do"
*run "ABS_proportions_plract_AUTO&OTHER.do"

* EDA : Pluriactivity (on relevant subcategory)
run "REL_proportions_plract_S&NS.do"
run "REL_proportions_plract_IND&W.do"
*run "REL_proportions_plract_AUTO&OTHER.do"

* EDA : Gender breakdown IND/W
run "Gender_alanysis.do"

* EDA : Activity breakdown IND/W

run "sector_analysis_wage.do"
run "sector_analysis_ALL.do"



